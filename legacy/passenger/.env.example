# Copie para .env e preencha com os dados do seu projeto Firebase (Configurações do projeto → Seus apps → Web).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Authentication → Google → Configuração do SDK da Web (ID do cliente da Web).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Só para o app no celular (Google Cloud → Credenciais → IDs de cliente OAuth).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

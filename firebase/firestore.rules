rules_version = '2';

// Regras do TrustCab, versão 2.
//
// Princípio: a única pessoa com conta é o motorista, e ele só alcança o que é dele.
// O passageiro não tem login — tudo o que ele faz entra pela página de agendamento, que é uma
// Cloud Function. A Function escreve com o Admin SDK e não passa por aqui, então estas regras não
// precisam abrir nada para quem não está autenticado. Nenhum documento é público: nem o link, nem
// a lista de passageiros, nem a agenda.
//
// O que o servidor escreve e o app nunca: links (o endereço público), users.slug, users.plan,
// e qualquer agenda vinda da página.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function onlyChanged(keys) { return incoming().diff(existing()).affectedKeys().hasOnly(keys); }

    function agendaDoc(id) { return get(/databases/$(database)/documents/agendas/$(id)).data; }
    function passengerDoc(id) { return get(/databases/$(database)/documents/passengers/$(id)).data; }

    function mine(data) { return data.driverId == me(); }

    function validTime(t) { return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function validDate(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function validPrice(p) { return p == null || (p is int && p >= 0 && p <= 10000000); }
    function validText(s, max) { return s is string && s.size() <= max; }
    // Só os dígitos de DDD + número.
    function validPhone(p) { return p is string && p.matches('^[0-9]{10,11}$'); }

    // Dias, janela e vagas que a página de agendamento oferece.
    function validSlots(s) {
      return s.keys().hasOnly(['weekdays', 'from', 'to', 'stepMinutes', 'seats'])
        && s.weekdays is list && s.weekdays.size() >= 1 && s.weekdays.size() <= 7
        && s.weekdays.hasOnly([0, 1, 2, 3, 4, 5, 6])
        && validTime(s.from) && validTime(s.to)
        && s.stepMinutes in [15, 30, 60]
        && s.seats is int && s.seats >= 1 && s.seats <= 10;
    }

    // Chave Pix do motorista: ela só sai daqui dentro da mensagem de cobrança que ele mesmo manda.
    function validPix(p) {
      return p == null
        || (p.keys().hasOnly(['type', 'key'])
          && p.type in ['cpf', 'phone', 'email', 'random']
          && validText(p.key, 80) && p.key.size() > 0);
    }

    function agendaFieldKeys() {
      return ['kind', 'weekdays', 'date', 'time', 'origin', 'destination', 'note', 'price'];
    }
    function validAgendaFields(d) {
      return d.keys().hasAll(agendaFieldKeys())
        && d.kind in ['recurring', 'single']
        && d.weekdays is list && d.weekdays.size() <= 7 && d.weekdays.hasOnly([0, 1, 2, 3, 4, 5, 6])
        && (d.kind == 'single' ? validDate(d.date) : (d.date == null && d.weekdays.size() > 0))
        && validTime(d.time)
        && validText(d.origin, 200) && d.origin.size() > 0
        && validText(d.destination, 200) && d.destination.size() > 0
        && validText(d.note, 280)
        && validPrice(d.price);
    }

    // Perfil do motorista. Nome, e-mail, link e plano não mudam pelo app: o link nasce no servidor
    // e o plano é o que estamos cobrando — se o app pudesse escrever, o teste nunca acabaria.
    match /users/{uid} {
      allow get: if signedIn() && uid == me();
      allow create: if signedIn() && uid == me()
        && incoming().keys().hasOnly(['name', 'email', 'photoURL', 'phone', 'vehicle', 'pix', 'slug', 'slots',
          'plan', 'fcmTokens', 'notificationsEnabled', 'termsVersion', 'termsAcceptedAt', 'createdAt'])
        && incoming().vehicle == null
        && incoming().pix == null
        && incoming().slug == null
        && incoming().fcmTokens.size() == 0
        // O plano entra zerado: quem põe a data do fim do teste é a Function onUserCreated.
        && incoming().plan.status == 'trial' && incoming().plan.until == null && incoming().plan.source == 'none'
        && validSlots(incoming().slots)
        // O aceite dos termos entra na criação da conta e nunca mais muda pelo app.
        && incoming().termsVersion is int && incoming().termsVersion > 0;
      allow update: if signedIn() && uid == me()
        && onlyChanged(['phone', 'vehicle', 'pix', 'slots', 'fcmTokens', 'notificationsEnabled',
          'termsVersion', 'termsAcceptedAt'])
        && (incoming().phone == null || validPhone(incoming().phone))
        && (incoming().vehicle == null
          || (validText(incoming().vehicle.model, 60)
            && validText(incoming().vehicle.color, 30)
            && incoming().vehicle.plate is string && incoming().vehicle.plate.matches('^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$')))
        && validPix(incoming().pix)
        && validSlots(incoming().slots)
        && incoming().fcmTokens.size() <= 10
        // Aceitar uma versão nova dos termos é permitido; voltar atrás não.
        && incoming().termsVersion is int && incoming().termsVersion >= existing().termsVersion;
      allow list, delete: if false;
    }

    // O endereço público do motorista. Quem lê é a Function que desenha a página, com o Admin SDK:
    // o app descobre o próprio link pelo campo slug do perfil e não precisa desta coleção.
    match /links/{slug} {
      allow read, write: if false;
    }

    // Contatos do motorista. Ele cadastra, corrige o telefone e arquiva; apagar não, porque a
    // agenda e as viagens apontam para cá e sem o nome o histórico fica ilegível.
    match /passengers/{id} {
      allow get: if signedIn() && mine(existing());
      allow list: if signedIn() && mine(existing());
      allow create: if signedIn()
        && incoming().keys().hasOnly(['driverId', 'name', 'phone', 'note', 'archived', 'createdAt', 'updatedAt'])
        && incoming().driverId == me()
        && validText(incoming().name, 80) && incoming().name.size() > 0
        && validPhone(incoming().phone)
        && validText(incoming().note, 280)
        && incoming().archived == false;
      allow update: if signedIn() && mine(existing())
        && onlyChanged(['name', 'phone', 'note', 'archived', 'updatedAt'])
        && validText(incoming().name, 80) && incoming().name.size() > 0
        && validPhone(incoming().phone)
        && validText(incoming().note, 280)
        && incoming().archived is bool;
      allow delete: if false;
    }

    // Agenda. O pedido que vem da página é escrito pela Function; pelo app, só o motorista escreve
    // — e aí já nasce confirmado, porque combinar com alguém que está na frente dele não é pedido.
    match /agendas/{agendaId} {
      allow get, list: if signedIn() && mine(existing());

      allow create: if signedIn()
        && incoming().driverId == me()
        && incoming().keys().hasOnly(['driverId', 'passengerId', 'passengerName', 'passengerPhone', 'status',
          'source', 'startDate', 'createdAt', 'updatedAt', 'kind', 'weekdays', 'date', 'time', 'origin',
          'destination', 'note', 'price'])
        && incoming().status == 'confirmed'
        && incoming().source == 'driver'
        && passengerDoc(incoming().passengerId).driverId == me()
        && validText(incoming().passengerName, 80) && incoming().passengerName.size() > 0
        && validPhone(incoming().passengerPhone)
        && validDate(incoming().startDate)
        && validAgendaFields(incoming());

      // Responder ao pedido, acertar o que ficou combinado, ou encerrar.
      allow update: if signedIn() && mine(existing()) && (
        // Confirmar ou recusar o pedido que veio da página. O valor pode entrar na confirmação:
        // o acerto de preço acontece no WhatsApp e aqui ele só registra o que ficou.
        (existing().status == 'requested' && incoming().status in ['confirmed', 'declined']
          && validPrice(incoming().price)
          && onlyChanged(['status', 'price', 'updatedAt']))
        // Corrigir uma agenda confirmada: endereço errado, horário trocado, valor acertado depois.
        || (existing().status == 'confirmed' && incoming().status == 'confirmed'
          && validAgendaFields(incoming())
          && onlyChanged(agendaFieldKeys().concat(['updatedAt'])))
        // Encerrar.
        || (existing().status in ['requested', 'confirmed'] && incoming().status == 'ended'
          && incoming().endedBy in ['driver', 'passenger']
          && onlyChanged(['status', 'endedBy', 'updatedAt']))
      );

      allow delete: if false;
    }

    // Viagem do dia: id = agendaId_AAAA-MM-DD. Só o motorista escreve; o cancelamento que vem do
    // passageiro entra pela página e é a Function que grava, com cancelledBy = 'passenger'.
    match /trips/{id} {
      allow get: if signedIn() && (resource == null || mine(existing()));
      allow list: if signedIn() && mine(existing());

      allow create, update: if signedIn()
        && id == incoming().agendaId + '_' + incoming().date
        && incoming().driverId == me()
        && validDate(incoming().date) && validTime(incoming().time)
        && incoming().keys().hasOnly(['agendaId', 'driverId', 'passengerId', 'date', 'time', 'status',
          'cancelledBy', 'price', 'onTheWayAt', 'arrivedAt', 'completedAt', 'cancelledAt', 'updatedAt'])
        && validPrice(incoming().price)
        && tripMatchesAgenda()
        && incoming().status in ['on_the_way', 'arrived', 'completed', 'cancelled']
        && (incoming().status == 'cancelled' ? incoming().cancelledBy == 'driver' : incoming().cancelledBy == null);
      allow delete: if false;
    }

    function tripMatchesAgenda() {
      let a = agendaDoc(incoming().agendaId);
      return a.status == 'confirmed'
        && a.driverId == me()
        && a.passengerId == incoming().passengerId;
    }
  }
}

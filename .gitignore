google-services.json

# variáveis de ambiente locais (Firebase, Google)
.env*.local

# erros e sistema
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.tsbuildinfo
*.orig.*

# app antigo (mobile/) tem repositório próprio e não entra nos builds
mobile/
